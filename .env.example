# Runtime database. Omit both values to use file:local.db in local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional local path used by Drizzle Kit commands.
LOCAL_DATABASE_URL=file:local.db

# Optional GitHub token used by bun run sync:github.
GITHUB_TOKEN=

# Canonical site origin used by metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

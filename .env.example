# Runtime database. Omit both values to use file:local.db in local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional local path used by Drizzle Kit commands.
LOCAL_DATABASE_URL=file:local.db

# Optional GitHub token used by bun run sync:github.
GITHUB_TOKEN=

# Cloudflare R2 storage for library logos (admin uploads, icon sync, migration).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public custom domain bound to the bucket (no trailing slash), e.g. https://img.example.com
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=

# Canonical site origin used by metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
